{
  "name": "pylibmaster",
  "version": "1.5.25",
  "description": "Python 库管理工具",
  "main": "main.js",
  "author": "SoftheartedYYC",
  "email": "softheartedyyc@gmail.com",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "start": "electron .",
    "test": "node --require ./tests/bootstrap.js --test tests/**/*.test.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "dist": "npm run build:win"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "glob": "^11.0.0",
    "strip-ansi": "^6.0.1"
  },
  "dependencyNotes": {
    "strip-ansi": "Locked at ^6.0.1 because 7+ is ESM-only and incompatible with CommonJS require()"
  },
  "build": {
    "appId": "com.softheartedyyc.pylibmaster",
    "productName": "PyLibMaster",
    "icon": "renderer/assets/icon.ico",
    "directories": {
      "output": "dist"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "core/**/*",
      "utils/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "icon": "renderer/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "renderer/assets/icon.ico",
      "uninstallerIcon": "renderer/assets/icon.ico",
      "installerHeaderIcon": "renderer/assets/icon.ico",
      "license": "build/license.txt"
    },
    "publish": {
      "provider": "github",
      "owner": "SoftheartedYYC",
      "repo": "PyLibMaster"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
